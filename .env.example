# AfyaPulse environment variables
# --------------------------------
# Never commit a real .env file. Copy this file to .env.local and fill in
# your own values. Never prefix these with NEXT_PUBLIC_ — they are
# server-only secrets and must not be shipped to the browser.

# MongoDB connection string (required for /server/db)
MONGODB_URI=

# Auth.js v5 secret (run `openssl rand -base64 32` to generate one)
AUTH_SECRET=

# Groq API key (server-only AI insights, /server/services/ai-insights)
GROQ_API_KEY=
# Optional server-side model override; default follows the installed SDK example.
GROQ_MODEL=

# Resend API key (optional, transactional email for alerts/notifications)
RESEND_API_KEY=

# Resend sender (server-only). Use a verified domain sender in production,
# e.g. RESEND_FROM_EMAIL="AfyaPulse <noreply@example.com>"
RESEND_FROM_EMAIL=

# Initial password for provisioning the federal approver account
# (scripts/provision-federal-approver.ts). Required ONLY when that account
# needs a new password hash; existing hashes are never overwritten.
# Set it in the environment when running the script — never commit a value.
# ADMIN_INITIAL_PASSWORD=

# Demo access is account-based. Run npm run provision:demo interactively.
# No public environment flag, password, cookie or toggle selects demo data.
# Live community disclosure stays closed until these values are approved.
# Do not use a made-up policy version or privacy threshold.
COMMUNITY_CONSENT_VERSION=
MIN_AGGREGATE_GROUP_SIZE=
